# ============================================================

.classpath
.project
.settings/
.springBeans
.sts4-cache/


# ============================================================
# NETBEANS
# ============================================================

nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/


# ============================================================
# OPERATING SYSTEM
# ============================================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.directory


# ============================================================
# TEMPORARY / EDITOR FILES
# ============================================================

*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig
*.rej

*~
.~lock.*#


# ============================================================
# ARCHIVES / GENERATED FILES
# ============================================================

*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z


# ============================================================
# LOCAL CACHE
# ============================================================

.cache/
**/.cache/

.cache-loader/
**/.cache-loader/


# ============================================================
# REDSENA LOCAL DEVELOPMENT
# ============================================================

.local/
**/.local/

runtime/
**/runtime/

data/local/
**/data/local/

# Credenciales privadas específicas de RedSENA
redsena-credentials.json
redsena-secrets.json
redsena-firebase.json

**/redsena-credentials.json
**/redsena-secrets.json
**/redsena-firebase.json


# ============================================================
# DO NOT IGNORE PROJECT CONFIGURATION
# ============================================================

!AGENTS.md
!CLAUDE.md

!**/pom.xml
!**/package.json
!**/package-lock.json

!**/compose.yaml
!**/compose.yml
!**/docker-compose.yml
!**/docker-compose.yaml

!**/Dockerfile
!**/.dockerignore

!**/application.properties
!**/application.yml
!**/application.yaml
```
