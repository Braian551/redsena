# Server-only file. Copy to .env.production and replace every placeholder.
# Do not commit .env.production or print it in logs.

POSTGRES_DB=redsena
POSTGRES_USER=redsena
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
# Comma-separated Firebase emails allowed to administer posts and media.
ADMIN_EMAILS=

# Public Firebase Web configuration used at frontend build time.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-firebase-messaging-sender-id
VITE_FIREBASE_APP_ID=replace-with-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=
VITE_GRAPHQL_URL=/graphql

# The shared VPS edge reaches RedSENA through Docker's host bridge gateway.
# Keep this private binding unless the edge topology changes explicitly.
REDSENA_HTTP_BIND=172.17.0.1
REDSENA_HTTP_PORT=18080
