type PostMedia {
  id: ID!
  url: String!
  contentType: String!
  size: Int!
}

type Post {
  id: ID!
  author: User!
  content: String!
  createdAt: String!
  media: [PostMedia!]!
  likeCount: Int!
  commentCount: Int!
  likedByViewer: Boolean!
  comments: [Comment!]!
}

input CreatePostInput {
  content: String!
  mediaIds: [ID!]
}

input UpdatePostInput {
  content: String!
}

input ReportPostInput {
  postId: ID!
  reason: PostReportReason!
}

enum PostReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  VIOLENCE
  SEXUAL_CONTENT
  MISINFORMATION
  OTHER
}

enum PostReportStatus {
  OPEN
}

type PostReport {
  id: ID!
  reason: PostReportReason!
  status: PostReportStatus!
  createdAt: String!
}

type PostLikeResult {
  liked: Boolean!
  likeCount: Int!
}
